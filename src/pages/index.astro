---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import ColorBlock from '../components/ColorBlock.astro';
import FormulaCard from '../components/FormulaCard.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import { CALCULATORS, calculatorPath, getCalculator } from '../lib/calculators.ts';
import { HOME_CALCULATOR } from '../i18n/config.ts';
import { calculatorSchema } from '../lib/schema.ts';

/** The home calculator: the page used to have a twin at /percentage-calculator, now a 301 here. */
const main = getCalculator(`/${HOME_CALCULATOR}`);
/** The directory lists every other calculator; this one is at the top of the page. */
const others = CALCULATORS.filter((calculator) => calculator !== main);

const examples = [
  {
    question: 'What is 20% of 500?',
    answer: '100',
    working: '20 ÷ 100 × 500',
    href: '/?mode=percent-of&percent=20&value=500',
  },
  {
    question: '25 is what percent of 200?',
    answer: '12.5%',
    working: '25 ÷ 200 × 100',
    href: '/what-percent-is-x-of-y?part=25&whole=200',
  },
  {
    question: 'A price rises from $100 to $125',
    answer: '25% increase',
    working: '(125 − 100) ÷ 100 × 100',
    href: '/percentage-increase-calculator?original=100&final=125',
  },
  {
    question: '$100 item with 20% off',
    answer: '$80',
    working: '100 − (100 × 20 ÷ 100)',
    href: '/discount-calculator?price=100&percent=20',
  },
];

/**
 * The homepage FAQ targets the questions people actually type around
 * "percentage calculator". The first ten are those queries, kept close to the
 * wording they are searched with; the last four cover the tool and the privacy
 * position, which the query set does not reach. The tip and over-100% answers
 * came across from the standalone percentage calculator page this one absorbed.
 */
const faqs: FaqItem[] = [
  {
    question: 'what is percentage?',
    answer:
      'A percentage is a number or ratio expressed as a fraction of 100, represented by the percent symbol (%). It comes from the Latin phrase "per centum", meaning "by the hundred". Percentages provide a standardized baseline to compare proportions, shares, and relative growth across different totals without needing to compute common denominators.',
  },
  {
    question: 'How do I calculate my percentage?',
    answer:
      'To calculate your personal percentage (such as for an exam, test score, or goal achievement), divide your achieved score by the maximum possible total and multiply by 100: (Your Score ÷ Total Score) × 100. For example, scoring 42 marks out of 50 gives (42 ÷ 50) × 100 = 84%.',
  },
  {
    question: 'How to calculate the%?',
    answer:
      'To calculate the percent (%) of any number, divide the percentage rate by 100 to convert it into a decimal multiplier, then multiply that decimal by the total number. For example, to calculate 25% of 80: 25 ÷ 100 = 0.25, and 0.25 × 80 = 20. If you are calculating what percent one number is of another, use the proportion formula: (Part ÷ Total) × 100.',
  },
  {
    question: 'How to calculate a percentage formula?',
    answer:
      'The foundational percentage formula is: Percentage (%) = (Part ÷ Total) × 100. To calculate with it: 1) Divide the part by the total to obtain a decimal fraction. 2) Multiply that decimal fraction by 100. 3) Append the % symbol. For example, 35 out of 140 is (35 ÷ 140) × 100 = 25%. If you know the percentage and need to find the part, use Part = (Percentage ÷ 100) × Total. To calculate the total, use Total = Part ÷ (Percentage ÷ 100).',
  },
  {
    question: 'How much is 30% in 100?',
    answer:
      '30% in 100 is exactly 30. Because percent translates literally to "per hundred", any percentage taken of 100 is numerically identical to the percentage figure itself: (30 ÷ 100) × 100 = 30.',
  },
  {
    question: 'How to calculate a percentage formula?',
    answer:
      'To calculate percentage change or growth between two values, use the percentage increase/decrease formula: ((New Value − Original Value) ÷ Original Value) × 100. Subtract the starting value from the new value, divide by the starting value, and multiply by 100. A positive result indicates a percentage increase, while a negative result represents a percentage decrease.',
  },
  {
    question: 'What formula is 2 * pi * r?',
    answer:
      'The formula 2 * pi * r (or C = 2πr) calculates the circumference (perimeter) of a circle, where r represents the radius and π (pi) is approximately 3.14159. In applied percentage problems and geometry, it is commonly used to calculate percentage growth in circular perimeters when a radius changes, or in circumference-based body fat percentage formulas.',
  },
  {
    question: 'What is 80% of 100?',
    answer:
      '80% of 100 is 80. Since a percentage represents parts per hundred, 80 percent of 100 is calculated as (80 ÷ 100) × 100 = 80.',
  },
  {
    question: 'how to calculate percentage in calculator?',
    answer:
      'On a standard handheld or smartphone calculator: 1) Multiply the base number by the percentage rate, then press the % key (e.g. 500 × 20 % = 100). 2) If your calculator does not have a % key, divide the percentage by 100 and multiply by the base number (20 ÷ 100 × 500 = 100). On our free online percentage calculator, enter both values into the input fields to get the answer and complete step-by-step arithmetic instantly.',
  },
  {
    question: 'What is a percentage increase calculator?',
    answer:
      'It measures how much a value has grown relative to where it started, using ((New − Original) ÷ Original) × 100. A salary going from 45,000 to 52,000 is a 15.56% increase. The original value is the reference, which is why the same 50 rise is a 50% increase on 100 but only a 5% increase on 1,000.',
  },
  {
    question: 'What is what percent of what?',
    answer:
      'It is shorthand for the three questions percentages ask. "What is X% of Y" finds a part. "X is what percent of Y" finds the percentage. "X is Y% of what" finds the total. Three quantities are involved — part, total and percentage — and you always know two of them. Spotting which one is missing tells you which calculation to run, and that recognition is where most wrong answers come from, not the arithmetic.',
  },
  {
    question: 'What is the difference between percentage change and percentage difference?',
    answer:
      'Percentage change has a direction: it measures a new value against an original one, so going from 100 to 120 is a 20% increase. Percentage difference has no direction — it compares two values against their average, so 100 and 120 differ by 18.18%. Use change when one value came first, and difference when neither did.',
  },
  {
    question: 'How do I work out 15% of a bill for a tip?',
    answer:
      'Take 10% by moving the decimal one place left, halve that to get 5%, then add them together. On a $64 bill: 10% is $6.40, 5% is $3.20, so 15% is $9.60.',
  },
  {
    question: 'Can a percentage be more than 100%?',
    answer:
      'Yes. 100% of a number is the number itself, so anything above 100% is larger than the original — 150% of 200 is 300. Percentages above 100 turn up constantly in growth figures and in comparisons against a baseline.',
  },
  {
    question: 'Are my calculations sent anywhere?',
    answer:
      'No. Every calculation runs in your browser using JavaScript on the page. Nothing you type is transmitted to a server, and your recent calculations are stored only in your own browser until you clear them.',
  },
  {
    question: 'Can I use decimals, negative numbers and large values?',
    answer:
      'Yes. Decimals, negatives and very large numbers all work, and you can type thousands separators such as 1,234,567 or 12,34,567 — both grouping styles are understood.',
  },
  {
    question: 'Do I need to create an account?',
    answer: 'No. Every calculator is free and works immediately, with no account and no sign-up.',
  },
];
---

<BaseLayout
  title="Percentage Calculator — Free Online Percent Calculators Hub"
  description="Free online percentage calculator with step-by-step working. Use our all-in-one percent calculator and percentage calculators hub for increase, grades, and discounts."
  ogTitle="Percentage Calculator — Free Online Percent Calculators Hub"
  ogDescription="Free online percentage calculator with step-by-step working. Use our all-in-one percent calculator and percentage calculators hub for increase, grades, and discounts."
  path="/"
  pageKey="home"
  schema={[
    calculatorSchema({
      name: 'Percentage Calculator',
      description:
        'Free online percentage calculator and percent calculators hub that shows step-by-step working for percentage of a number, percentage increase, decrease, change, difference and discounts.',
      path: '/',
    }),
  ]}
>
  {/*
    White hero — the monochrome frame this system opens on. The calculator
    itself sits in the hero as a hairline card so the tool is reachable in the
    first screen.
  */}
  {/*
    A warm ground behind the hero. One surface at the point of first impression
    does more than tinting many smaller things, and the calculator card reads as
    an object sitting on it. This one follows the theme rather than pinning a
    pastel, because it wraps interactive surfaces.
  */}
  <div class="bg-hero">
  <section class="mx-auto max-w-site px-4 pt-12 pb-16 sm:px-8 sm:pt-20 sm:pb-24">
    <div class="grid grid-cols-[minmax(0,1fr)] items-start gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,32rem)] lg:gap-16">
      <div>
        <p class="eyebrow">Free · No sign-up</p>
        <h1 class="mt-6 text-display-xl text-balance">Free percentage calculators with step-by-step working.</h1>
        <p class="mt-7 max-w-xl text-body-lg">
          Fourteen calculators, each showing the formula and every step behind the answer. Use the
          one below for everyday percentages, or choose a dedicated calculator for grades, discounts,
          tax and more. Nothing you type leaves your browser.
        </p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#calculator" class="btn-primary">Start calculating</a>
          <a href="/how-to-calculate-percentage" class="btn-secondary">Learn the method</a>
        </div>
      </div>

      <div id="calculator" class="scroll-mt-20">
        <Calculator calculator={main} />
      </div>
    </div>
  </section>

  </div>

  {/*
    `marquee-strip` — the thin ribbon under the hero. Rendered static rather
    than animated: a scrolling ribbon is a motion hazard, and these entries are
    useful links rather than decoration.

    Lime rather than the inverse canvas. It is the one full-width surface high
    enough on the page to carry colour without becoming a section, and pastel
    grounds hold their colour in both themes, so the band reads the same way in
    dark mode instead of flipping to white.
  */}
  <div class="bg-lime text-block-ink">
    <div
      class="mx-auto flex max-w-site items-center gap-8 overflow-x-auto px-4 py-3 whitespace-nowrap sm:px-8 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    >
      <span class="caption shrink-0 opacity-70">Try one</span>
      {
        examples.map((example) => (
          <a
            href={example.href}
            class="caption shrink-0 underline-offset-4 transition-opacity hover:opacity-70 hover:underline"
          >
            {example.question} = {example.answer}
          </a>
        ))
      }
    </div>
  </div>

  <div class="mx-auto max-w-site px-4 sm:px-8">
    {/* Calculator directory */}
    <section id="all-calculators" aria-labelledby="tools-heading" class="mt-24 scroll-mt-20">
      <h2 id="tools-heading" class="text-display-lg">All percentage calculators</h2>
      <p class="mt-5 max-w-2xl text-body">
        Each one is a dedicated page with its formula, a worked example and the situations it suits.
      </p>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          others.map((calculator) => (
            <li>
              <a
                href={calculatorPath(calculator)}
                class="flex h-full flex-col gap-2 rounded-lg border border-hairline bg-canvas p-8 transition-shadow hover:shadow-soft"
              >
                <span class="text-card-title">
                  {calculator.name}
                </span>
                <span class="text-body">{calculator.blurb}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* How it works */}
    <section aria-labelledby="how-heading" class="mt-24">
      <h2 id="how-heading" class="max-w-3xl text-display-lg">How percentage calculations work</h2>
      <div class="prose-site mt-6 max-w-3xl">
        <p>
          <strong>Per cent</strong> means “per hundred”. A percentage is a way of writing a fraction
          whose bottom number is always 100, which is what makes percentages easy to compare: 37% and
          42% can be judged against each other instantly, while <code>37/94</code> and{' '}
          <code>42/107</code> cannot.
        </p>
        <p>
          Almost every percentage question is one of three shapes, and knowing which one you are
          looking at is most of the work. The <a href="#calculator">calculator at the top of this
          page</a> answers all three — pick the tab that matches your question.
        </p>
      </div>

      <div class="mt-8 flex max-w-3xl flex-col gap-8">
        <div>
          <h3 class="text-card-title">1. What is X% of Y?</h3>
          <p class="mt-2 text-body">
            You have the percentage and the whole, and want the part — a tip, a commission, a tax
            amount or a share of a budget.
          </p>
          <div class="mt-4">
            <FormulaCard
              formula="(Percentage ÷ 100) × Number"
              substituted="(20 ÷ 100) × 500 = 100"
              caption="Dividing by 100 converts the percentage to a decimal; multiplying applies it."
            />
          </div>
        </div>

        <div>
          <h3 class="text-card-title">2. X is what percent of Y?</h3>
          <p class="mt-2 text-body">
            You have the part and the whole, and want the percentage. This turns a raw score into a
            comparable figure — 38 out of 50 becomes 76%.
          </p>
          <div class="mt-4">
            <FormulaCard
              formula="(Part ÷ Whole) × 100"
              substituted="(25 ÷ 200) × 100 = 12.5%"
              caption="Dividing gives a decimal share; multiplying by 100 expresses it per hundred."
            />
          </div>
        </div>

        <div>
          <h3 class="text-card-title">3. X is Y% of what number?</h3>
          <p class="mt-2 text-body">
            You have the part and the percentage, and want the whole — the reverse of the first
            question, and how you recover an original total from a deposit or a commission.
          </p>
          <div class="mt-4">
            <FormulaCard
              formula="Part ÷ (Percentage ÷ 100)"
              substituted="50 ÷ (20 ÷ 100) = 250"
              caption="Because multiplying by the percentage produced the part, dividing undoes it."
            />
          </div>
        </div>
      </div>

      <div class="prose-site mt-8 max-w-3xl">
        <p>
          Comparisons between two numbers are a separate family: <a href="/percentage-change-calculator"
            >percentage change</a
          >, <a href="/percentage-increase-calculator">increase</a>,{' '}
          <a href="/percentage-decrease-calculator">decrease</a> and{' '}
          <a href="/percentage-difference-calculator">difference</a> each answer a slightly different
          question. The <a href="/percentage-formula">formula reference</a> sets out exactly when to reach
          for which.
        </p>
      </div>
    </section>

    {/* Common examples */}
    <section aria-labelledby="examples-heading" class="mt-24">
      <h2 id="examples-heading" class="text-display-lg">Common examples</h2>
      <p class="mt-5 max-w-2xl text-body">
        Each example opens the calculator with the numbers already filled in.
      </p>

      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          examples.map((example) => (
            <li>
              <a
                href={example.href}
                class="flex h-full flex-col gap-2 rounded-lg bg-coral p-8 text-block-ink transition-shadow hover:shadow-soft"
              >
                <span class="text-body">{example.question}</span>
                <span class="numeric text-display-lg">{example.answer}</span>
                <span class="numeric text-body-sm">{example.working}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <Faq items={faqs} heading="Frequently asked questions" />

    {/*
      Long-form explainer. This is the page's substantive content for search:
      it covers what the tool does, which calculation answers which question,
      and where each one is used. Written to be read, not to hit a density.
    */}
    <section aria-labelledby="about-heading" class="mt-24">
      <h2 id="about-heading" class="text-display-lg">About this percentage calculators hub</h2>

      <div class="prose-site mt-5">
        <p>
          A <strong>percentage calculator</strong> turns everyday mathematical questions into immediate,{' '}
          trustworthy answers. Whether you are balancing a personal budget, verifying a seasonal discount,{' '}
          determining a salary raise, analyzing team standings, or tracking health milestones, percentages{' '}
          are the universal language of comparison. This website is designed as a comprehensive{' '}
          <strong>percentage calculators hub</strong> — an all-in-one suite of fourteen specialized tools{' '}
          that show not just the final result, but the complete formula and step-by-step arithmetic behind{' '}
          every answer.
        </p>
        <p>
          Unlike traditional desktop accessories or complicated spreadsheet formulas, an online{' '}
          <strong>percent calculator</strong> provides instant clarity with zero barrier to entry. Every{' '}
          calculation executes directly inside your web browser in real time. Nothing you type is ever{' '}
          transmitted across a network, no accounts or sign-ups are requested, and your numbers remain{' '}
          completely private on your own device.
        </p>

        <h3>Everyday arithmetic made simple with a modern percent calculator</h3>
        <p>
          Percentages can feel deceivingly simple until an unexpected sign, a compounding figure, or a{' '}
          missing total leads to an incorrect decision. The fundamental strength of a dedicated{' '}
          <strong>percentage calculator</strong> is transparency: an answer you cannot verify is an answer{' '}
          you are forced to trust blindly. By laying out the underlying mathematical steps in plain language{' '}
          with your exact figures substituted, this tool allows students, educators, professionals, and{' '}
          consumers to confirm accuracy in seconds and learn the methodology for future use.
        </p>

        <h3>The three fundamental questions behind every percentage calculation</h3>
        <p>
          Almost all everyday percentage problems revolve around three core quantities: a{' '}
          <strong>part</strong>, a <strong>whole</strong>, and the <strong>percentage</strong> connecting{' '}
          them. In any practical scenario, you invariably know two of these numbers and need to solve for{' '}
          the third. Misidentifying which value is missing is where the vast majority of mathematical{' '}
          mistakes happen:
        </p>
        <ul>
          <li>
            <strong>What is X% of Y? (Finding the Part):</strong> When you know the percentage and base{' '}
            value, solve for the portion. Common examples include restaurant tips, sales taxes, and commissions.{' '}
            The formula divides the percentage by 100 and multiplies by the total.
          </li>
          <li>
            <strong>X is What Percent of Y? (Finding the Percentage):</strong> When you know both the portion{' '}
            and the whole, you want to express the relationship on a standardized scale of 100. This turns a{' '}
            test score like 42 out of 50 into a comparable 84% —{' '}
            <a href="/what-percent-is-x-of-y">calculate it with our dedicated tool</a>.
          </li>
          <li>
            <strong>X is Y% of What Number? (Finding the Whole):</strong> When you have a portion and know its{' '}
            percentage representation, work backward to reveal the original whole. This is the exact math{' '}
            required to{' '}
            <a href="/x-is-y-percent-of-what">recover an original retail price</a> from a deposit or a{' '}
            post-discount total.
          </li>
        </ul>
        <p>
          Each of these three operations is integrated into the{' '}
          <a href="#calculator">percentage calculator at the top of this page</a>, enabling you to toggle{' '}
          between modes seamlessly without leaving the screen.
        </p>

        <h3>Measuring growth and reductions: the increase percentage calculator</h3>
        <p>
          Comparing numbers across time requires measuring relative movement rather than simple arithmetic{' '}
          differences. A dedicated <a href="/percentage-increase-calculator">increase percentage calculator</a>{' '}
          determines the exact rate of expansion relative to the starting baseline. For instance, an increase{' '}
          from 100 to 150 represents a 50% increase, because the growth of 50 is evaluated against the original{' '}
          100. In corporate finance, human resources, and real estate, using an{' '}
          <strong>increase percentage calculator</strong> ensures that salary adjustments, rent increments, and{' '}
          quarterly revenue metrics are fairly evaluated against inflation and market standards.
        </p>
        <p>
          Conversely, when values decline, a{' '}
          <a href="/percentage-decrease-calculator">percentage decrease calculator</a> quantifies reductions{' '}
          like retail markdowns and depreciation. For two-way trends, our{' '}
          <a href="/percentage-change-calculator">percentage change calculator</a> shows both direction{' '}
          and magnitude, while the{' '}
          <a href="/percentage-difference-calculator">percentage difference calculator</a> compares two{' '}
          standalone values against their average for symmetric, unbiased results.
        </p>

        <h3>Academic &amp; statistical tools: grade, test, and average percentage calculators</h3>
        <p>
          In educational environments, evaluating student performance requires specialized scoring tools.{' '}
          Our <a href="/grade-percentage-calculator">grade percentage calculator</a> transforms raw scores{' '}
          into standardized percentages and corresponding letter grades. It functions equally well as a{' '}
          comprehensive <strong>test percentage calculator</strong>, whether you are evaluating a quick{' '}
          classroom quiz, a standardized midterm, or an end-of-year university exam.
        </p>
        <p>
          When consolidating scores or survey results across distinct cohorts, many people fall into the trap{' '}
          of averaging percentages directly. However, scoring 90% on a 10-point quiz and 60% on a 100-point{' '}
          exam does not yield a 75% average; the true weighted performance is 62.7%. Our{' '}
          <a href="/average-percentage-calculator">average percentage calculator</a> solves this dilemma by{' '}
          presenting both the simple unweighted average and the weighted average percentage based on group{' '}
          size, preventing one of the most widespread statistical errors in business and academia.
        </p>

        <h3>Sports &amp; competitive metrics: win &amp; winning percentage calculators</h3>
        <p>
          Tracking athletic standings and competitive success demands accurate win-loss ratios. Our{' '}
          <a href="/win-percentage-calculator">win percentage calculator</a> enables sports analysts,{' '}
          coaches, fantasy league players, and gamers to evaluate performance records effortlessly. Also known{' '}
          as a <strong>winning percentage calculator</strong>, this tool handles ties using professional sports{' '}
          conventions (such as NFL and NHL standards), crediting each draw as half a win rather than ignoring{' '}
          it. Whether assessing seasonal records with our winning percentage calculator or evaluating sales close{' '}
          rates, this tool provides precise decimal averages and percentage rates instantly.
        </p>

        <h3>Health, body composition, and fitness percentage calculators</h3>
        <p>
          Tracking physical fitness and personal wellness is another area where percentages offer much greater{' '}
          insight than raw measurements. Our{' '}
          <a href="/body-fat-percentage-calculator">body fat percentage calculator</a> utilizes the{' '}
          scientifically validated US Navy circumference method to estimate body composition from simple tape{' '}
          measurements of the neck, waist, hips, and height. As a convenient{' '}
          <strong>fat percentage calculator</strong>, it categorizes results into established fitness and health{' '}
          bands for both men and women without requiring costly clinical scans.
        </p>
        <p>
          Similarly, when embarking on a wellness program or participating in community challenges, raw scale{' '}
          weight can be deceptive. Losing 15 pounds from a 150-pound starting point represents 10% of total mass,{' '}
          whereas the same 15 pounds from a 300-pound starting point represents only 5%. Our{' '}
          <a href="/weight-loss-percentage-calculator">weight loss percentage calculator</a> — whether you are{' '}
          searching for a fitness and weight loss percentage calculator (often searched as an{' '}
          <strong>fweight loss percentage calculator</strong>) or a general progress tracker — normalizes results{' '}
          across participants of differing builds, ensuring an equitable evaluation of dedication and milestone{' '}
          achievements.
        </p>

        <h3>Why choose our percentage calculators hub? Fast, private, and verified</h3>
        <p>
          As a purpose-built <strong>percentage calculators hub</strong>, our platform brings together 14{' '}
          mathematically verified tools in one lightweight, intuitive interface. Every calculator is static,{' '}
          responsive, and engineered for maximum speed on mobile devices and desktop computers alike. Because the{' '}
          arithmetic runs purely in your browser via client-side JavaScript, your financial figures, test scores,{' '}
          and personal health metrics remain strictly confidential. Explore the tools above, verify your figures{' '}
          with complete confidence, and make percentage calculations effortless today.
        </p>
        <p>
          If you want the mathematical theory and step-by-step methods rather than just the final answer, the{' '}
          <a href="/how-to-calculate-percentage">guide to calculating percentages</a> covers the core arithmetic{' '}
          and mental shortcuts, while our comprehensive <a href="/percentage-formula">percentage formula reference</a>{' '}
          sets out every formula side by side with the distinctions between them made explicit.
        </p>
      </div>
    </section>

    {/* Trust / utility */}
    <section aria-labelledby="trust-heading" class="mt-24">
      <h2 id="trust-heading" class="text-display-lg">Why these calculators</h2>
      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          [
            {
              tone: 'lime',
              term: 'The working, not just the answer',
              detail:
                'Every result shows the formula, the numbers substituted into it, and each step in plain language.',
            },
            {
              tone: 'mint',
              term: 'Nothing leaves your browser',
              detail:
                'The maths runs on your device. No accounts, no calculation logs, no values sent to a server.',
            },
            {
              tone: 'cream',
              term: 'Honest about rounding',
              detail:
                'Repeating decimals are marked with ≈ rather than presented as exact, so you know when a result is rounded.',
            },
            {
              tone: 'lilac',
              term: 'Built to be fast',
              detail:
                'A static page with a few kilobytes of JavaScript — it loads quickly on a phone and on a slow connection.',
            },
          ].map((item) => (
            <div
              class:list={[
                'rounded-lg p-8',
                // Pastel grounds keep their colour in both themes, so text on
                // them is pinned rather than following the theme's ink.
                'text-block-ink',
                { lime: 'bg-lime', mint: 'bg-mint', cream: 'bg-cream', lilac: 'bg-lilac' }[
                  item.tone
                ],
              ]}
            >
              <dt class="text-card-title">{item.term}</dt>
              <dd class="mt-2 text-body">{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </section>
  </div>

