  description="The terms covering use of the Percentage Calculator website and its calculators."
  path="/terms"
  h1="Terms of service"
  crumbLabel="Terms"
  updated="13 September 2026"
  intro="The terms you accept by using this site. They are deliberately short."
>
  <div class="prose-site">
    <h2>Acceptance</h2>
    <p>
      By using {SITE.name} you accept these terms. If you do not accept them, please do not use the
      site.
    </p>

    <h2>Using the site</h2>
