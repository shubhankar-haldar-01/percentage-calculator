---
/**
 * Server error page.
 *
 * Deliberately short. The 404 lists every calculator because a wrong address is
 * a navigation problem and a list solves it; a 500 is not, and a wall of links
 * under an error the reader cannot act on reads as noise.
 *
 * This is a static site, so nothing here can raise a 500 on its own — it would
 * come from the host or CDN. Most static hosts will serve this file for origin
 * errors once pointed at it; see the README for the per-host setting.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Something went wrong"
  description="This page could not be served. Reloading usually fixes it."
  path="/500"
  noindex
>
  <div class="mx-auto max-w-3xl px-4 py-16 sm:px-6 sm:py-24">
    <p class="eyebrow">Error 500</p>
    <h1 class="mt-5 text-display-lg text-balance">Something went wrong on our end</h1>

    <p class="mt-4 max-w-xl text-body">
      This page could not be served. It is not something you did, and nothing you typed into a
      calculator was lost — those run entirely in your browser and never reach a server.
    </p>
    <p class="mt-4 max-w-xl text-body">
      Reloading the page usually clears it. If it keeps happening,{' '}
      <a href="/contact" class="underline underline-offset-4">let me know</a> and include the address
      you were trying to reach.
    </p>

    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Go to the calculator</a>
      <a href="/contact" class="btn-secondary">Contact</a>
    </div>
  </div>
</BaseLayout>
