---
import CalculatorLayout from '../layouts/CalculatorLayout.astro';
import FormulaCard from '../components/FormulaCard.astro';
import WorkedExample from '../components/WorkedExample.astro';
import Faq, { type FaqItem } from '../components/Faq.astro';
import RelatedCalculators from '../components/RelatedCalculators.astro';
import { getCalculator, related } from '../lib/calculators.ts';

const calculator = getCalculator('/percentage-increase-calculator');

const faqs: FaqItem[] = [
  {
    question: 'How do I calculate percentage increase?',
    answer:
      'Subtract the original value from the new value, divide the result by the original value, then multiply by 100. Going from 100 to 150: 150 − 100 = 50, then 50 ÷ 100 = 0.5, then 0.5 × 100 = 50%.',
  },
  {
    question: 'What is the percentage increase from 100 to 150?',
    answer:
      '50%. The value rose by 50, and 50 is half of the original 100, so the increase is 50%.',
  },
  {
    question: 'Why do I divide by the original value and not the new one?',
    answer:
      'Because an increase is measured against where you started. Dividing by the new value would answer a different question — what share of the final figure the growth represents — and would give a smaller number for the same movement.',
  },
  {
    question: 'What is the difference between a percentage increase and percentage points?',
    answer:
      'Percentage points measure the gap between two percentages directly. If a rate rises from 4% to 5%, that is a rise of 1 percentage point, but a 25% increase. Both are correct; they answer different questions, and mixing them up is the single most common percentage error in reporting.',
  },
  {
    question: 'What if my value went down instead of up?',
    answer:
      'The calculator says so rather than returning a confusing negative — it will tell you the size of the decrease and point you to the percentage decrease calculator.',
  },
  {
    question: 'How do I add a percentage increase to a number?',
    answer:
      'Multiply by 1 plus the percentage as a decimal. To add 15% to 80, multiply 80 × 1.15 = 92. This is faster than working out the increase and adding it separately.',
  },
];
---

<CalculatorLayout
  pageKey="increase"
  calculator={calculator}
  title="Percentage Increase Calculator — Calculate Percent Growth"
  description="Calculate percentage increase between two numbers with step-by-step arithmetic. Perfect for salary raises, inflation, price growth, and investment gains."
  h1="Percentage Increase Calculator"
  intro="Find out how much a value has grown in percentage terms. Enter where it started and where it ended up, and this increase percentage calculator shows the result along with the arithmetic behind it."
>
  <section aria-labelledby="formula-heading" class="mt-24">
    <h2 id="formula-heading" class="text-display-lg">The percentage increase formula</h2>
    <p class="mt-3 text-body">
      A percentage increase measures growth <em>relative to where you started</em>. The original
      value is the reference point, which is why it sits on the bottom of the fraction.
    </p>

    <div class="mt-6">
      <FormulaCard
        formula="((New − Original) ÷ Original) × 100"
        substituted="((150 − 100) ÷ 100) × 100 = 50%"
        caption="The same £50 rise is a 50% increase on £100 but only a 5% increase on £1,000 — which is exactly why the original value matters."
      />
    </div>
  </section>

  <section aria-labelledby="example-heading" class="mt-24">
    <h2 id="example-heading" class="text-display-lg">Worked example: a pay rise</h2>
    <div class="mt-6">
      <WorkedExample
        scenario="Your salary goes from $45,000 to $52,000. What percentage rise is that?"
        steps={[
          { label: 'Find the size of the rise.', expression: '52,000 − 45,000 = 7,000' },
          { label: 'Divide it by the original salary.', expression: '7,000 ÷ 45,000 = 0.1556' },
          { label: 'Multiply by 100.', expression: '0.1556 × 100 ≈ 15.56%' },
        ]}
        answer="≈ 15.56% increase"
        href="/percentage-increase-calculator?original=45000&final=52000"
      />
    </div>
  </section>

  <section aria-labelledby="multipliers-heading" class="mt-24">
    <h2 id="multipliers-heading" class="text-display-lg">Quick decimal multipliers for percentage growth</h2>
    <div class="prose-site mt-4">
      <p>
        To apply a percentage increase directly to any figure in one mental step, multiply by (1 + percentage as a decimal):
      </p>

      <div class="overflow-x-auto rounded-lg border border-hairline not-prose my-6">
        <table class="w-full border-collapse text-left">
          <caption class="sr-only">Percentage increase rates and decimal multipliers</caption>
          <thead>
            <tr class="border-b border-hairline bg-surface-soft">
              <th scope="col" class="px-6 py-4 text-body-lg font-strong">Percentage Increase</th>
              <th scope="col" class="px-6 py-4 text-body-lg font-strong">Multiplier</th>
              <th scope="col" class="px-6 py-4 text-body-lg font-strong">Calculation on $100</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-hairline">
              <th scope="row" class="px-6 py-3 text-body font-semibold text-ink">+5% increase</th>
              <td class="numeric px-6 py-3 text-body">× 1.05</td>
              <td class="px-6 py-3 text-body">$100 × 1.05 = $105.00</td>
            </tr>
            <tr class="border-b border-hairline">
              <th scope="row" class="px-6 py-3 text-body font-semibold text-ink">+10% increase</th>
              <td class="numeric px-6 py-3 text-body">× 1.10</td>
              <td class="px-6 py-3 text-body">$100 × 1.10 = $110.00</td>
            </tr>
            <tr class="border-b border-hairline">
              <th scope="row" class="px-6 py-3 text-body font-semibold text-ink">+15% increase</th>
              <td class="numeric px-6 py-3 text-body">× 1.15</td>
              <td class="px-6 py-3 text-body">$100 × 1.15 = $115.00</td>
            </tr>
            <tr class="border-b border-hairline">
              <th scope="row" class="px-6 py-3 text-body font-semibold text-ink">+20% increase</th>
              <td class="numeric px-6 py-3 text-body">× 1.20</td>
              <td class="px-6 py-3 text-body">$100 × 1.20 = $120.00</td>
            </tr>
            <tr class="border-b border-hairline">
              <th scope="row" class="px-6 py-3 text-body font-semibold text-ink">+25% increase</th>
              <td class="numeric px-6 py-3 text-body">× 1.25</td>
              <td class="px-6 py-3 text-body">$100 × 1.25 = $125.00</td>
            </tr>
            <tr class="border-b border-hairline">
              <th scope="row" class="px-6 py-3 text-body font-semibold text-ink">+50% increase</th>
              <td class="numeric px-6 py-3 text-body">× 1.50</td>
              <td class="px-6 py-3 text-body">$100 × 1.50 = $150.00</td>
            </tr>
            <tr class="border-b border-hairline">
              <th scope="row" class="px-6 py-3 text-body font-semibold text-ink">+100% increase (double)</th>
              <td class="numeric px-6 py-3 text-body">× 2.00</td>
              <td class="px-6 py-3 text-body">$100 × 2.00 = $200.00</td>
            </tr>
            <tr class="last:border-0">
              <th scope="row" class="px-6 py-3 text-body font-semibold text-ink">+200% increase (triple)</th>
              <td class="numeric px-6 py-3 text-body">× 3.00</td>
              <td class="px-6 py-3 text-body">$100 × 3.00 = $300.00</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section aria-labelledby="uses-heading" class="mt-24">
    <h2 id="uses-heading" class="text-display-lg">When you need a percentage increase</h2>
    <div class="prose-site mt-4">
      <ul>
        <li>
          <strong>Pay rises</strong> — turning a raise into a figure you can compare against
          inflation or against last year's rise.
        </li>
        <li>
          <strong>Price and rent rises</strong> — judging whether an increase is in line with the
          market or out of step with it.
        </li>
        <li>
          <strong>Business growth</strong> — revenue, orders or subscribers this quarter against
          last.
        </li>
        <li>
          <strong>Website traffic</strong> — month-over-month sessions, where the percentage matters
          far more than the raw number.
        </li>
        <li>
          <strong>Investment gains</strong> — the return on a holding between two points in time.
        </li>
      </ul>

      <h3>A trap worth knowing</h3>
      <p>
        A percentage increase and the percentage decrease that undoes it are <em>not</em> the same
        number. If a $100 item rises 50% to $150, it takes a 33.3% fall — not 50% — to get back to
        $100. The increase is measured against $100 and the decrease against $150, so the same $50
        movement produces two different percentages. The{' '}
        <a href="/percentage-decrease-calculator">percentage decrease calculator</a> works the other direction.
      </p>
    </div>
  </section>

  <Faq items={faqs} />

  <RelatedCalculators
    calculators={related(calculator.related)}
  />
</CalculatorLayout>
