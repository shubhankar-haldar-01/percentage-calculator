---
/**
 * Theme toggle — `button-icon-circular` shape (40px, surface-soft, circular).
 *
 * Three states: with no stored choice the page follows the OS, and pressing the
 * button pins an explicit one. Which icon shows is handled in CSS so the
 * correct glyph is painted on first frame, including in system-dark.
 */
---

<button
  type="button"
  data-theme-toggle
  class="btn-icon shrink-0"
  aria-label="Switch to dark theme"
  title="Switch theme"
>
  {/* Shown while the page is light — press for dark. */}
  <svg
    data-icon="moon"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-5"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>

  {/* Shown while the page is dark — press for light. */}
  <svg
    data-icon="sun"
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="size-5"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
    ></path>
  </svg>
</button>

<script>
  const STORAGE_KEY = 'pc:theme';
  const root = document.documentElement;

  /** What the page is actually showing right now. */
  function resolved(): 'light' | 'dark' {
    const pinned = root.dataset.theme;
    if (pinned === 'light' || pinned === 'dark') return pinned;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function paint() {
    const theme = resolved();
    const next = theme === 'dark' ? 'light' : 'dark';
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
      button.setAttribute('aria-label', `Switch to ${next} theme`);
    }
    // Keep the browser chrome in step with the page.
    document
      .querySelector<HTMLMetaElement>('meta[name="theme-color"]:not([media])')
      ?.setAttribute('content', theme === 'dark' ? '#000000' : '#ffffff');
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const next = resolved() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem(STORAGE_KEY, next);
      } catch {
        /* Private mode — the choice just will not persist. */
      }
      paint();
    });
  }

  // Follow the OS while no explicit choice is stored.
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (!root.dataset.theme) paint();
  });

  paint();
</script>
