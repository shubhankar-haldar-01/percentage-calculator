---
/**
 * One shared template for every translated calculator page.
 *
 * The English pages under `src/pages/` stay hand-authored and carry extra
 * bespoke sections; this renders the translated content registry into a
 * consistent, substantial page for the other locales.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Calculator from './Calculator.astro';
import LocalizedCalcSections from './LocalizedCalcSections.astro';
import { getCalculator } from '../lib/calculators.ts';
import { calcKeyForSlug, LOCALE_META, pathFor, SLUGS, type Locale, type PageKey } from '../i18n/config.ts';
import { contentFor } from '../i18n/content/index.ts';
import type { CalcPageKey } from '../i18n/content/types.ts';
import { ui } from '../i18n/ui/index.ts';
import { breadcrumbSchema, calculatorSchema } from '../lib/schema.ts';

interface Props {
  locale: Locale;
  pageKey: CalcPageKey;
}

const { locale, pageKey } = Astro.props;
const t = ui(locale);
const content = contentFor(locale);
const page = content.calculators[pageKey];
const labels = content.labels;

// The tool definition is shared; only its wording is localized.
const calculator = getCalculator(`/${SLUGS.en[pageKey as PageKey]}`);
const path = pathFor(locale, pageKey);
const currency = pageKey === 'discount' || pageKey === 'tax';

// The display name labels the crumb and the app, as it does on the English
// pages, so an H1 can describe the page's task without lengthening the
// breadcrumb.
const crumbs = [
  { label: t.sections.home, path: pathFor(locale, 'home') },
  { label: labels.names[pageKey], path },
];

/**
 * The same hand-picked siblings as the English page. Taking the first four
 * keys instead gave every translated calculator the same four links, so a tax
 * page linked percentage change rather than the discount calculator.
 */
const related = calculator.related.map((slug) => calcKeyForSlug(slug) as CalcPageKey);
---

<BaseLayout
  locale={locale}
  pageKey={pageKey}
  title={page.title}
  description={page.description}
  path={path}
  schema={[
    calculatorSchema({
      name: labels.names[pageKey],
      description: page.description,
      path,
      inLanguage: LOCALE_META[locale].tag,
    }),
    breadcrumbSchema(crumbs),
  ]}
>
  {/*
    The same warm band the homepage hero uses, so every page in the site opens
    the same way instead of the inner pages reading as a plainer sibling.
  */}
  <div class="bg-hero">
    <div class="mx-auto max-w-3xl px-4 pt-10 pb-12 sm:px-6 sm:pt-16 sm:pb-16">
      <Breadcrumbs crumbs={crumbs} locale={locale} />

      <h1 class="text-display-lg text-balance">{page.h1}</h1>
      <p class="mt-5 max-w-2xl text-body-lg">{page.intro}</p>

      <div class="mt-10">
        <Calculator calculator={calculator} locale={locale} currency={currency} />
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-3xl px-4 pb-16 sm:px-6">
    <LocalizedCalcSections locale={locale} pageKey={pageKey} />

    <section aria-labelledby="related-heading" class="mt-24">
      <h2 id="related-heading" class="text-display-lg">{t.sections.related}</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          related.map((key) => (
            <li>
              <a
                href={pathFor(locale, key)}
                class="flex h-full flex-col gap-2 rounded-lg border border-hairline bg-canvas p-8 transition-shadow hover:shadow-soft"
              >
                <span class="text-card-title">{labels.names[key]}</span>
                <span class="text-body">{labels.blurbs[key]}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</BaseLayout>
