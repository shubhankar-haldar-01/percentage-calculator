---
/**
 * hreflang alternates.
 *
 * Every locale variant of a page points at every other, including itself, plus
 * an `x-default` on the English URL — the reciprocal set Google expects.
 * Pages that exist only in English (the policy pages) pass no key and emit
 * nothing, which is correct: an incomplete set is worse than none.
 */
import { alternates, type PageKey } from '../i18n/config.ts';
import { absoluteUrl } from '../lib/site.ts';

interface Props {
  pageKey?: PageKey;
}

const { pageKey } = Astro.props;
const links = pageKey ? alternates(pageKey) : [];
---

{
  links.map((entry) => (
    <link rel="alternate" hreflang={entry.tag} href={absoluteUrl(entry.path)} />
  ))
}
{
  pageKey && (
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(alternates(pageKey)[0]!.path)} />
  )
}
