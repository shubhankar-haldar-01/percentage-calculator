---
/**
 * hreflang alternates.
 *
 * Every indexable locale variant of a page points at every other, including
 * itself, plus an `x-default` on the English URL — the reciprocal set Google
 * expects. Pages that exist only in English (the policy pages) and pages kept
 * out of search pass no key and emit nothing, which is correct: an incomplete
 * set is worse than none.
 */
import { indexedAlternates, type PageKey } from '../i18n/config.ts';
import { absoluteUrl } from '../lib/site.ts';

interface Props {
  pageKey?: PageKey;
}

const { pageKey } = Astro.props;
const links = pageKey ? indexedAlternates(pageKey) : [];
---

{
  links.map((entry) => (
    <link rel="alternate" hreflang={entry.tag} href={absoluteUrl(entry.path)} />
  ))
}
{
  links.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(links[0]!.path)} />
  )
}
