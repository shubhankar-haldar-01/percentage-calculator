---
import { Font } from 'astro:assets';
import SEO from '../components/SEO.astro';
import Hreflang from '../components/Hreflang.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { organizationSchema, websiteSchema } from '../lib/schema.ts';
import { adsensePublisherId, googleSiteVerification } from '../lib/site.ts';
import { DEFAULT_LOCALE, LOCALE_META, type Locale, type PageKey } from '../i18n/config.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  modified?: string;
  /** Identifies the page across locales, for hreflang. */
  pageKey?: PageKey;
  /** BCP-47 tag for <html lang>. */
  locale?: Locale;
}

const {
  title,
  description,
  path,
  noindex = false,
  schema = [],
  ogType = 'website',
  modified,
  pageKey,
  locale = DEFAULT_LOCALE,
} = Astro.props;

// The site-level graph is emitted on every page so the Organization and
// WebSite nodes referenced by page schema always resolve.
const allSchema = [websiteSchema(), organizationSchema(), ...schema];
---

<!doctype html>
<html lang={LOCALE_META[locale].tag}>
  <head>
    {/*
      Google tag (gtag.js). The dataLayer stub runs immediately so the page
      view and any early events queue up, but the 180 KB library itself is
      fetched on the visitor's first interaction, or 5 s after `load` for
      anyone who only reads. Loaded eagerly — even with `async` — it competes
      for bandwidth with the page's own CSS, fonts and scripts, and its
      evaluation is the only long main-thread task on the page.

      It sets the _ga cookies and calls googletagmanager.com, so the privacy
      policy states that plainly. The numbers typed into a calculator are not
      sent anywhere: the engine runs in the browser and no event carries them.
    */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      // The address without its query string: a shared calculator link
      // carries its numbers there, and they must not reach analytics.
      gtag('config', 'G-60HTQBPZEL', { page_location: location.origin + location.pathname });

      (function () {
        var events = ['pointerdown', 'keydown', 'scroll', 'touchstart'];
        var loaded = false;
        function load() {
          if (loaded) return;
          loaded = true;
          events.forEach(function (e) { removeEventListener(e, load, { passive: true }); });
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-60HTQBPZEL';
          document.head.appendChild(s);
        }
        events.forEach(function (e) { addEventListener(e, load, { once: true, passive: true }); });
        addEventListener('load', function () { setTimeout(load, 5000); });
      })();
    </script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/*
      Applied before first paint so a pinned dark theme never flashes white.
      With nothing stored the page simply follows the OS via CSS.
    */}
    <script is:inline>
      try {
        var pinned = localStorage.getItem('pc:theme');
        if (pinned === 'dark' || pinned === 'light') document.documentElement.dataset.theme = pinned;
      } catch (e) {
        /* Storage blocked — fall back to the OS preference. */
      }
    </script>

    {/*
      No `prefers-color-scheme` variant: the page does not follow the OS, so the
      browser chrome must not either. The toggle rewrites this when a visitor
      picks dark.
    */}
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="percentage calculator" />
    {/*
      Ownership verification for Search Console and AdSense, each emitted only
      once its value is set in SITE. The AdSense tag is used rather than the
      AdSense script because it proves ownership without loading any ad code.
    */}
    {googleSiteVerification && <meta name="google-site-verification" content={googleSiteVerification} />}
    {adsensePublisherId && <meta name="google-adsense-account" content={`ca-${adsensePublisherId}`} />}
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    <Hreflang pageKey={pageKey} />

    <SEO
      locale={locale}
      pageKey={pageKey}
      title={title}
      description={description}
      path={path}
      noindex={noindex}
      schema={allSchema}
      ogType={ogType}
      modified={modified}
    />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-md bg-ink px-4 py-2 text-body-sm font-medium text-inverse-ink focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-[60]"
    >
      Skip to main content
    </a>

    <Header locale={locale} pageKey={pageKey} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
  </body>
</html>
